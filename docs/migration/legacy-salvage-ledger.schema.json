{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veridist.dev/schemas/legacy-salvage-ledger.schema.json",
  "title": "veridist legacy salvage ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_namespace", "legacy_package", "entries"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "target_namespace": {"const": "veridist"},
    "legacy_package": {"const": "distfit_pro"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "component", "component_kind", "target", "status", "disposition", "source", "license", "evidence", "reviews", "isolation", "limits"],
        "properties": {
          "id": {"type": "string", "pattern": "^LM-[0-9]{3}$"},
          "component": {"type": "string", "minLength": 1},
          "component_kind": {"type": "string", "minLength": 1},
          "target": {"type": "object"},
          "status": {"enum": ["review_pending", "archived"]},
          "disposition": {"enum": ["modify_port", "rewrite", "archive"]},
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["commit", "path", "blob", "sha256"],
            "properties": {
              "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "path": {"type": "string", "pattern": "^distfit_pro/"},
              "blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "license": {"const": "MIT"},
          "evidence": {"type": "object"},
          "reviews": {"type": "object"},
          "isolation": {"type": "object"},
          "limits": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
